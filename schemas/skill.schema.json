{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/breadtitor/local-prompt-studio/main/schemas/skill.schema.json",
  "title": "Local Prompt Studio Skill manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name",
    "entrypoint"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "include": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "source"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
