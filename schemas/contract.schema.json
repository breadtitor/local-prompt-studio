{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/breadtitor/local-prompt-studio/main/schemas/contract.schema.json",
  "title": "Local Prompt Studio output contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "name"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "required_sections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "min_output_chars": {
      "type": "integer",
      "minimum": 1
    },
    "max_output_chars": {
      "type": "integer",
      "minimum": 1
    },
    "forbidden_substrings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "reference_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reference_index_base": {
      "enum": [0, 1]
    },
    "require_all_attachments_referenced": {
      "type": "boolean"
    }
  }
}
